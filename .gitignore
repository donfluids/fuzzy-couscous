build/
build_*/
out/
out_*/
*.h5
*.xdmf
*.png
*.pdf
*.swp
.DS_Store
__pycache__/
*.pyc

# Run artifacts: data outputs, run logs, PGO profiling data
*.npz
*.log
*.gcda

# Consolidated runs/ tree: ignore all run data (out_*/, scaling runs_*/logs_*/
# pgo_*, HDF5, CSV, per-run TOML clones), but keep the tracked structure --
# runs/README.md, runs/MANIFEST.md, and per-category runs/<cat>/.gitkeep.
runs/*/*
!runs/*/.gitkeep

# Permit committed figures under paper/figures/
!paper/figures/*.png
!paper/figures/*.pdf
